{
  "name": "olan",
  "private": true,
  "version": "42.0.0",
  "type": "module",
  "description": "OLAN HIGH TECH — сайт, админ-панель и кабинет оператора в одном проекте",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "check": "node scripts/check.js",
    "clean": "node scripts/clean.js",
    "reinstall": "node scripts/clean.js && npm install",
    "start": "node scripts/check.js --quiet --server-only && node server/index.js",
    "server": "npm start",
    "dev": "node scripts/dev-all.js",
    "site": "node scripts/check.js --quiet && vite --config vite.site.config.js",
    "admin": "node scripts/check.js --quiet && vite --config vite.admin.config.js",
    "operator": "node scripts/check.js --quiet && vite --config vite.operator.config.js",
    "manager": "node scripts/check.js --quiet && vite --config vite.manager.config.js",
    "build": "node scripts/check.js --quiet && vite build --config vite.site.config.js && vite build --config vite.admin.config.js && vite build --config vite.operator.config.js && vite build --config vite.manager.config.js && node scripts/seo.js",
    "preview": "vite preview --config vite.site.config.js",
    "postinstall": "node scripts/check.js --after-install",
    "seo": "node scripts/seo.js",
    "translate": "node scripts/translate-all.mjs",
    "audit": "node scripts/audit-apps.mjs",
    "audit:server": "node scripts/audit-server.mjs",
    "audit:admin": "node scripts/audit-admin.mjs"
  },
  "dependencies": {
    "libphonenumber-js": "^1.13.13",
    "lucide-react": "^0.487.0",
    "motion": "12.23.24",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.12",
    "@vitejs/plugin-react": "4.7.0",
    "tailwindcss": "4.1.12",
    "tw-animate-css": "1.3.8",
    "vite": "6.3.5",
    "jsdom": "^30.1.0"
  }
}