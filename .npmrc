# Отключаем шумный вывод, чтобы реальные ошибки установки было видно сразу.
fund=false
audit=false

# Пакет lucide-react содержит около 1500 мелких файлов. На Windows с антивирусом
# или синхронизацией OneDrive установка иногда обрывается на середине.
# Эти настройки делают её устойчивее.
fetch-retries=5
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000
