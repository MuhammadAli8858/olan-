# ---------------------------------------------------------------------------
# Один .env на весь проект. Скопируйте этот файл в .env и правьте под себя:
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Адрес API-сервера. Для работы на своём компьютере оставьте localhost.
# Если открываете сайт/админку с другого устройства в сети — впишите IP
# компьютера, на котором запущен сервер. Пример: http://192.168.222.171:3001
# VITE_API_URL=http://localhost:3001

# Порт API-сервера
PORT=3001

# Логин и пароль администратора (админ-панель, порт 9000)
ADMIN_USER=user
ADMIN_KEY=admin1971


# Путь к файлу контента. Менять не нужно — по умолчанию берётся
# apps/site/src/app/data/siteData.js
# SITE_DATA_FILE=./apps/site/src/app/data/siteData.js

# Операторы и менеджеры больше НЕ задаются здесь.
# Их создаёт администратор в админ-панели, раздел «Сотрудники».

# ---------------------------------------------------------------------------
# Ключ переводчика (необязательно, но на хостинге почти обязателен).
#
# Без ключа сервер ходит на бесплатный публичный эндпоинт Google. С домашнего
# интернета это работает, а серверам в дата-центрах (Render и подобные)
# Google часто отвечает 403 — и перевод просто не идёт.
#
# Ключ создаётся в Google Cloud Console: включить Cloud Translation API,
# затем APIs & Services → Credentials → Create credentials → API key.
# Весь сайт (~96 000 знаков) обходится примерно в два доллара.
# ---------------------------------------------------------------------------
# TRANSLATE_API_KEY=AIza...

# Боевой адрес сайта. Используется для canonical, OG-тегов и sitemap.xml.
SITE_URL=https://olan.uz

# Картинка для превью ссылки в мессенджерах (1200x630 будет лучше всего).
OG_IMAGE=/products/w-space.png

# ---------------------------------------------------------------------------
# Возврат правок из админ-панели в исходный код (нужно только на хостинге).
#
# На своём компьютере админка и так пишет прямо в
# apps/site/src/app/data/siteData.js — эти переменные не нужны.
#
# На хостинге контент лежит на постоянном диске, а репозиторий остаётся
# со старым текстом. Заполните переменные — и после каждого сохранения
# сервер будет коммитить свежий siteData.js обратно в GitHub.
#
# Токен создаётся здесь: GitHub → Settings → Developer settings →
# Personal access tokens → Fine-grained tokens. Нужен доступ к своему
# репозиторию и право Contents: Read and write.
# ---------------------------------------------------------------------------
# GITHUB_TOKEN=github_pat_...
# GITHUB_REPO=user/olan
# GITHUB_BRANCH=main
# GITHUB_PATH=apps/site/src/app/data/siteData.js

# Выключить автоматический коммит после каждого сохранения
# (кнопка «В код» в админке продолжит работать вручную):
# GIT_AUTO_PUSH=false

# Куда складывать файлы и фото из чата. Локально по умолчанию
# apps/site/public/chat-files, на хостинге — папка на постоянном диске.
# CHAT_UPLOAD_DIR=/var/data/chat-files
